---
import PageLayout from '../layouts/PageLayout.astro';
import { siteConfig } from '../data/site';
import { productsData } from '../data/products';
import { industriesData } from '../data/industries';
import { images } from '../data/images';
import ProductCard from '../components/ProductCard.astro';
import BlogCard from '../components/BlogCard.astro';
import StatsCounter from '../components/react/StatsCounter';
import ThreeDIcon from '../components/ThreeDIcon.astro';
import CTA from '../components/CTA.astro';
import IndustriesVelocity from '../components/react/IndustriesVelocity';
import ProcessJourney from '../components/react/ProcessJourney';
import StatementSection from '../components/StatementSection.astro';
import SecondStatementSection from '../components/SecondStatementSection.astro';
import ClientsSection from '../components/ClientsSection.astro';
import { getCollection } from 'astro:content';

const allBlogPosts = await getCollection('blog');
const sortedPosts = allBlogPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featuredPosts = sortedPosts.slice(0, 3);
---

<PageLayout
  title={`${siteConfig.name} — ${siteConfig.tagline}`}
  description={siteConfig.description}
>
  <!-- ========================================================================= -->
  <!-- 1. HERO SECTION (Editorial, Minimal, Controlled PCB Green Accent) -->
  <!-- ========================================================================= -->
  <section class="relative w-full pt-12 pb-16 sm:pt-16 sm:pb-24 lg:pt-20 lg:pb-28 bg-[#F7F7F5] border-b border-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        <!-- Hero Left Column: Copy & Actions -->
        <div class="lg:col-span-7 space-y-6">
          <!-- Clean Matte Technical Eyebrow Badge (No Glow, No Neon) -->
          <div data-hero-eyebrow class="inline-flex items-center gap-2 px-3 py-1 bg-white border border-border rounded-sm">
            <span class="w-1.5 h-1.5 bg-brand-500 rounded-full" />
            <span class="text-[11px] font-mono tracking-wider text-dark font-semibold uppercase">
              01 // INDONESIA'S TRUSTED PCB MANUFACTURING PARTNER
            </span>
          </div>

          <!-- Mixed Typography Headline (PCB-Focused) -->
          <h1
            data-hero-headline
            class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-dark tracking-tight leading-[1.12] font-display"
            style="font-size: clamp(2.3rem, 5.2vw, 4.25rem);"
          >
            Engineering Precision Circuits,<br />
            Built for <span class="font-script text-brand-600 font-normal text-[1.15em] inline-block -rotate-1">High-Yield Hardware</span>
          </h1>

          <!-- Subtitle -->
          <p data-hero-copy class="text-sm sm:text-base text-secondary max-w-xl leading-relaxed">
            High-precision multi-layer PCB fabrication and rapid SMT assembly services for innovators, engineering teams, and electronics manufacturers throughout Indonesia.
          </p>

          <!-- CTA Buttons with Controlled PCB Green -->
          <div data-hero-cta class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-2">
            <a
              href="/quote"
              class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-sm bg-brand-500 hover:bg-brand-600 text-white font-mono text-xs font-semibold uppercase tracking-wider transition-all hover:translate-x-0.5 min-h-[44px] border border-brand-600 shadow-sm"
            >
              <span data-nav-link="Get a Quote">Get a Quote</span>
              <span class="text-sm">→</span>
            </a>

            <a
              href="/contact"
              class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-sm bg-white hover:bg-surface-secondary text-dark font-mono text-xs font-semibold uppercase tracking-wider border border-border hover:border-dark/60 transition-colors min-h-[44px]"
            >
              <span data-nav-link="Talk to Our Team">Talk to Our Team</span>
            </a>
          </div>

          <!-- Value Propositions (Matte Brutalist Grid) -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-8 border-t border-border">
            <!-- 1. Quality -->
            <div data-hero-badge class="space-y-1 p-3.5 bg-white border border-border rounded-sm">
              <span class="text-[10px] font-mono text-brand-600 uppercase tracking-wider font-bold block">01 / QUALITY</span>
              <h4 class="text-xs font-bold font-display text-dark">IPC Class 2 & 3</h4>
              <p class="text-[11px] text-secondary">AOI & X-Ray inspection</p>
            </div>

            <!-- 2. Speed -->
            <div data-hero-badge class="space-y-1 p-3.5 bg-white border border-border rounded-sm">
              <span class="text-[10px] font-mono text-brand-600 uppercase tracking-wider font-bold block">02 / SPEED</span>
              <h4 class="text-xs font-bold font-display text-dark">24-72h Quick Turn</h4>
              <p class="text-[11px] text-secondary">Prototypes to mass</p>
            </div>

            <!-- 3. Advanced Multilayer Capability -->
            <div data-hero-badge class="space-y-1 p-3.5 bg-white border border-border rounded-sm">
              <span class="text-[10px] font-mono text-brand-600 uppercase tracking-wider font-bold block">03 / CAPABILITY</span>
              <h4 class="text-xs font-bold font-display text-dark">1-32 Layers HDI</h4>
              <p class="text-[11px] text-secondary">Controlled impedance</p>
            </div>

            <!-- 4. DFM -->
            <div data-hero-badge class="space-y-1 p-3.5 bg-white border border-border rounded-sm">
              <span class="text-[10px] font-mono text-brand-600 uppercase tracking-wider font-bold block">04 / DFM</span>
              <h4 class="text-xs font-bold font-display text-dark">Direct Support</h4>
              <p class="text-[11px] text-secondary">Impedance & stackups</p>
            </div>
          </div>
        </div>

        <!-- Hero Right Column: Pure Macro PCB & Handwritten Script (Prominent on Mobile & Desktop) -->
        <div class="lg:col-span-5 relative mt-4 lg:mt-0">
          <!-- Handwritten Script Annotation with Arrow -->
          <div
            data-hero-script
            class="relative text-right mb-3 z-10"
          >
            <div class="font-script text-xl sm:text-2xl font-bold text-dark/90 leading-tight">
              Better Electronics,<br />
              <span class="text-brand-600">A Brighter Indonesia</span>
            </div>
            <!-- Hand-drawn subtle curved arrow -->
            <svg class="w-8 sm:w-10 h-6 sm:h-7 text-brand-600 ml-auto -mt-1" viewBox="0 0 50 40" fill="none" stroke="currentColor">
              <path d="M10 5 C 25 15, 35 25, 42 32" stroke-width="2" stroke-linecap="round" />
              <path d="M34 33 L 42 32 L 40 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>

          <!-- Grounded Brutalist PCB Image Frame -->
          <div
            data-hero-image-frame
            class="relative rounded-sm overflow-hidden border border-border bg-white shadow-sm w-full"
          >
            <img
              src={images.hero.pcbMain.src}
              alt={images.hero.pcbMain.alt}
              class="w-full h-auto object-cover aspect-[4/3]"
              width="640"
              height="480"
              loading="eager"
            />
            <div class="absolute inset-0 bg-dark/5 pointer-events-none" />
          </div>

          <!-- Monospaced Technical Status Bar Below Image -->
          <div
            data-hero-floating-card
            class="mt-3 flex items-center justify-between text-[11px] font-mono text-secondary border-t border-border pt-2 px-1"
          >
            <span class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 bg-brand-500 rounded-full" />
              <span data-i18n-en="PRECISION SMT & MULTILAYER PCB" data-i18n-id="PERAKITAN SMT PRESISI & PCB MULTILAYER">PRECISION SMT & MULTILAYER PCB</span>
            </span>
            <span data-i18n-en="MADE IN INDONESIA" data-i18n-id="BUATAN INDONESIA" class="text-brand-600 font-bold">MADE IN INDONESIA</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 2. LARGE EDITORIAL STATEMENT (Green Field + Scroll-Linked Horizontal Motion) -->
  <!-- ========================================================================= -->
  <StatementSection />

  <!-- ========================================================================= -->
  <!-- 3. BUILT FOR INDONESIA'S ELECTRONICS FUTURE -->
  <!-- ========================================================================= -->
  <section data-intro-section class="w-full py-16 lg:py-24 bg-white border-b border-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        <!-- Left: Headline & National Narrative -->
        <div data-intro-text class="lg:col-span-5 space-y-4">
          <div class="inline-flex items-center gap-2 px-2.5 py-1 bg-surface-secondary border border-border rounded-sm">
            <span class="w-1.5 h-1.5 bg-brand-500 rounded-full" />
            <span class="text-[11px] font-mono tracking-wider text-brand-700 font-bold uppercase">
              02 // NATIONAL IMPACT & SOVEREIGNTY
            </span>
          </div>

          <!-- Mixed Typography Headline -->
          <h2 class="text-2xl sm:text-4xl font-extrabold text-dark tracking-tight leading-tight font-display">
            Built for Indonesia's <span class="font-script text-brand-600 font-normal text-[1.15em] inline-block -rotate-1">Electronics Future</span>
          </h2>

          <p class="text-xs sm:text-sm text-secondary leading-relaxed pt-1">
            We are dedicated to strengthening Indonesia's domestic hardware ecosystem. By pairing multi-layer PCB fabrication, precision SMT assembly, and strict IPC Class 3 quality inspection under one roof, we eliminate overseas supply chain friction and empower Indonesian engineers to manufacture world-class electronic devices locally.
          </p>

          <p class="text-xs sm:text-sm text-secondary leading-relaxed">
            From IoT sensors and telecommunication equipment to automotive power controllers and industrial automation, we ensure high repeatability, transparent domestic billing, and rapid turnaround.
          </p>

          <div class="pt-2">
            <a
              href="/about"
              class="inline-flex items-center gap-2 text-xs font-mono font-semibold text-brand-600 hover:text-brand-700 transition-colors group"
            >
              <span data-i18n-en="Explore our manufacturing philosophy" data-i18n-id="Pelajari filosofi manufaktur kami">Explore our manufacturing philosophy</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </a>
          </div>
        </div>

        <!-- Center: Industrial Photography (Pure Circuit Architecture, No Humans) -->
        <div class="lg:col-span-4 space-y-2">
          <div class="bg-dark text-white font-mono text-[10px] px-3 py-1.5 flex items-center justify-between rounded-t-sm">
            <span>[ SYSTEM // ADVANCED SMT & FABRICATION ]</span>
            <span class="text-brand-400 font-bold">ACTIVE</span>
          </div>

          <div data-intro-image class="rounded-b-sm overflow-hidden border border-border aspect-[4/3] bg-surface-secondary">
            <img
              src={images.introducing.factoryCleanroom.src}
              alt={images.introducing.factoryCleanroom.alt}
              class="w-full h-full object-cover"
              loading="lazy"
              width="600"
              height="450"
            />
          </div>

          <div data-intro-badge class="text-[11px] font-mono text-secondary flex items-center justify-between px-1">
            <span>SPEC: 1–32 LAYERS • CONTROLLED IMPEDANCE</span>
            <span class="text-brand-600 font-semibold">ISO 9001:2015</span>
          </div>
        </div>

        <!-- Right: Animated Stats Counter Island -->
        <div class="lg:col-span-3 pt-2 lg:pt-0">
          <StatsCounter client:load />
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 3. OUR PRODUCTS & SERVICES (High-Quality PCB Manufacturing Imagery) -->
  <!-- ========================================================================= -->
  <section data-products-section class="w-full py-16 lg:py-24 bg-[#F7F7F5] border-b border-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Section Header -->
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 gap-4 border-b border-border pb-6">
        <div>
          <div class="inline-flex items-center gap-2 px-2.5 py-1 bg-white border border-border rounded-sm mb-2">
            <span class="w-1.5 h-1.5 bg-brand-500 rounded-full" />
            <span class="text-[11px] font-mono tracking-wider text-brand-700 font-bold uppercase">
              03 // CAPABILITIES & CATALOG
            </span>
          </div>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-dark tracking-tight font-display">
            Our Products & <span class="font-script text-brand-600 font-normal text-[1.15em] inline-block -rotate-1">Services</span>
          </h2>
          <p class="mt-2 text-xs sm:text-sm text-secondary max-w-lg">
            Complete PCB fabrication, assembly, and turnkey hardware engineering solutions built for commercial reliability.
          </p>
        </div>

        <a
          href="/products"
          class="inline-flex items-center gap-1.5 text-xs font-mono font-semibold text-brand-600 hover:text-brand-700 transition-colors group"
        >
          <span>View All Products</span>
          <span class="group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>

      <!-- 4 Products Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {productsData.map((prod, idx) => (
          <ProductCard product={prod} index={idx + 1} />
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 4. POWERING INNOVATION ACROSS INDUSTRIES -->
  <!-- ========================================================================= -->
  <section data-industries-section class="w-full py-16 lg:py-24 bg-[#111513] text-white border-y border-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Section Header -->
      <div data-industries-header class="max-w-2xl mb-8 space-y-2">
        <div class="inline-flex items-center gap-2 px-2.5 py-1 bg-white/10 border border-white/20 rounded-sm">
          <span class="w-1.5 h-1.5 bg-brand-400 rounded-full" />
          <span class="text-[11px] font-mono tracking-wider text-brand-300 font-bold uppercase">
            04 // SECTORS SERVED
          </span>
        </div>
        <h2 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight font-display">
          Powering Innovation <span class="font-script text-brand-400 font-normal text-[1.15em] inline-block -rotate-1">Across Industries</span>
        </h2>
        <p class="text-xs sm:text-sm text-white/70 leading-relaxed pt-1">
          High-performance PCB substrates engineered to endure demanding operational conditions across 7 mission-critical sectors.
        </p>
      </div>

      <!-- Horizontal Momentum Island -->
      <div data-industries-velocity>
        <IndustriesVelocity industries={industriesData} client:load />
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 5. WHY BUILD WITH PCB INDONESIA? (3D-Style Colorful Icons) -->
  <!-- ========================================================================= -->
  <section data-why-us-section class="w-full py-16 lg:py-24 bg-[#F7F7F5] border-b border-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div data-why-us-header class="max-w-2xl mb-12">
        <div class="inline-flex items-center gap-2 px-2.5 py-1 bg-white border border-border rounded-sm mb-2">
          <span class="w-1.5 h-1.5 bg-brand-500 rounded-full" />
          <span class="text-[11px] font-mono tracking-wider text-brand-700 font-bold uppercase">
            05 // VALUE PROPOSITIONS
          </span>
        </div>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-dark tracking-tight font-display">
          Why Build With <span class="font-script text-brand-600 font-normal text-[1.15em] inline-block -rotate-1">PCB Indonesia</span>
        </h2>
        <p class="mt-2 text-xs sm:text-sm text-secondary leading-relaxed">
          We combine local proximity, global manufacturing certifications, and direct engineering collaboration to eliminate offshore supply chain delays.
        </p>
      </div>

      <!-- 4 Editorial Benefit Columns with 3D-Style Colorful Icons -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 pt-6 border-t-2 border-dark">
        <!-- 1. Engineering Expertise -->
        <div data-why-us-card class="group space-y-3 p-6 bg-white border border-border rounded-sm hover:border-dark transition-all duration-300">
          <ThreeDIcon name="engineering" class="w-16 h-16 mb-2" />
          <span class="text-xs font-mono font-bold text-brand-600 block">01 //</span>
          <h3 class="text-base font-bold font-display text-dark group-hover:text-brand-600 transition-colors">
            Engineering Expertise
          </h3>
          <p class="text-xs text-secondary leading-relaxed">
            In-house technical support assisting with DFM audits, high-speed routing, controlled impedance, and material selection.
          </p>
        </div>

        <!-- 2. Quality First -->
        <div data-why-us-card class="group space-y-3 p-6 bg-white border border-border rounded-sm hover:border-dark transition-all duration-300">
          <ThreeDIcon name="quality" class="w-16 h-16 mb-2" />
          <span class="text-xs font-mono font-bold text-brand-600 block">02 //</span>
          <h3 class="text-base font-bold font-display text-dark group-hover:text-brand-600 transition-colors">
            Certified Quality
          </h3>
          <p class="text-xs text-secondary leading-relaxed">
            Strict quality standards compliant with IPC-A-600/610 Class 2 & 3, automated 3D AOI, and radiographic X-Ray inspection.
          </p>
        </div>

        <!-- 3. Domestic Facility in Bogor -->
        <div data-why-us-card class="group space-y-3 p-6 bg-white border border-border rounded-sm hover:border-dark transition-all duration-300">
          <ThreeDIcon name="domestic" class="w-16 h-16 mb-2" />
          <span class="text-xs font-mono font-bold text-brand-600 block">03 //</span>
          <h3 class="text-base font-bold font-display text-dark group-hover:text-brand-600 transition-colors">
            Zero Customs Friction
          </h3>
          <p class="text-xs text-secondary leading-relaxed">
            Direct engineering collaboration, fast dispatch from our Bogor facility, zero offshore customs delays, and express domestic logistics.
          </p>
        </div>

        <!-- 4. Scalable Production -->
        <div data-why-us-card class="group space-y-3 p-6 bg-white border border-border rounded-sm hover:border-dark transition-all duration-300">
          <ThreeDIcon name="scalable" class="w-16 h-16 mb-2" />
          <span class="text-xs font-mono font-bold text-brand-600 block">04 //</span>
          <h3 class="text-base font-bold font-display text-dark group-hover:text-brand-600 transition-colors">
            Scalable Capacity
          </h3>
          <p class="text-xs text-secondary leading-relaxed">
            Seamlessly transition from quick-turn prototype batches to 100,000+ volume production with consistent material stackups.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 6. SECOND EDITORIAL STATEMENT: ENGINEERED FOR WHAT'S NEXT -->
  <!-- ========================================================================= -->
  <SecondStatementSection />

  <!-- ========================================================================= -->
  <!-- 7. FROM CONCEPT TO PRODUCTION: ZIGZAG SVG PATH + LOTTIE -->
  <!-- ========================================================================= -->
  <section data-process-section class="w-full py-16 lg:py-24 bg-white border-b border-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div data-process-header class="mb-10 border-b border-border pb-6 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
          <div class="inline-flex items-center gap-2 px-2.5 py-1 bg-surface-secondary border border-border rounded-sm mb-2">
            <span class="w-1.5 h-1.5 bg-brand-500 rounded-full" />
            <span class="text-[11px] font-mono tracking-wider text-brand-700 font-bold uppercase">
              06 // WORKFLOW PIPELINE
            </span>
          </div>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-dark tracking-tight font-display">
            From Concept to <span class="font-script text-brand-600 font-normal text-[1.15em] inline-block -rotate-1">Production</span>
          </h2>
          <p class="mt-1 text-xs sm:text-sm text-secondary">
            Seven verified engineering milestones from initial schematic concept to express ESD-shielded domestic delivery.
          </p>
        </div>

        <a
          href="/quote"
          class="inline-flex items-center gap-1.5 text-xs font-mono font-semibold text-brand-600 hover:text-brand-700 transition-colors group"
        >
          <span>Request an instant quote</span>
          <span class="group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>

      <!-- Vertical Zigzag Snake-Path Process Journey -->
      <div data-process-journey>
        <ProcessJourney client:load />
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 8. OUR CLIENTS & PARTNERS: CONTINUOUS MARQUEE -->
  <!-- ========================================================================= -->
  <ClientsSection />

  <!-- ========================================================================= -->
  <!-- 7. LATEST FROM OUR BLOG (Editorial Article Grid) -->
  <!-- ========================================================================= -->
  <section data-blog-section class="w-full py-16 lg:py-24 bg-white border-b border-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 gap-4 border-b border-border pb-6">
        <div>
          <div class="inline-flex items-center gap-2 px-2.5 py-1 bg-surface-secondary border border-border rounded-sm mb-2">
            <span class="w-1.5 h-1.5 bg-brand-500 rounded-full" />
            <span class="text-[11px] font-mono tracking-wider text-brand-700 font-bold uppercase">
              07 // KNOWLEDGE BASE
            </span>
          </div>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-dark tracking-tight font-display">
            Latest from <span class="font-script text-brand-600 font-normal text-[1.15em] inline-block -rotate-1">Our Blog</span>
          </h2>
          <p class="mt-1 text-xs sm:text-sm text-secondary">
            Technical guides, DFM best practices, and industry news from our engineering team.
          </p>
        </div>

        <a
          href="/blog"
          class="inline-flex items-center gap-1.5 text-xs font-mono font-semibold text-brand-600 hover:text-brand-700 transition-colors group"
        >
          <span>View All Articles</span>
          <span class="group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>

      <!-- 3 Editorial Blog Cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {featuredPosts.map((post, idx) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            category={post.data.category}
            featuredImage={post.data.featuredImage}
            slug={post.id ? post.id.replace(/\.md$/, '') : (post as any).slug}
            index={idx + 1}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 8. FINAL CALL TO ACTION (Minimalist Architectural Banner) -->
  <!-- ========================================================================= -->
  <CTA />

  <!-- Client-side GSAP Scroll Animations Initialization -->
  <script>
    import { initScrollAnimations } from '../lib/animations/scrollAnimations';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    let cleanup: (() => void) | null = null;

    function runAnimations() {
      if (cleanup) {
        cleanup();
      }
      cleanup = initScrollAnimations();

      window.addEventListener('load', () => {
        ScrollTrigger.refresh();
      }, { once: true });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', runAnimations);
    } else {
      runAnimations();
    }

    document.addEventListener('astro:page-load', runAnimations);
    document.addEventListener('astro:before-swap', () => {
      if (cleanup) {
        cleanup();
        cleanup = null;
      }
    });
  </script>
</PageLayout>
