---
import PageLayout from '../../layouts/PageLayout.astro';
import { industriesData, type IndustryItem } from '../../data/industries';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CTA from '../../components/CTA.astro';

export async function getStaticPaths() {
  return industriesData.map((industry) => ({
    params: { slug: industry.slug },
    props: { industry },
  }));
}

interface Props {
  industry: IndustryItem;
}

const { industry } = Astro.props;

const breadcrumbs = [
  { label: 'Industries', href: '/industries' },
  { label: industry.name },
];

const otherIndustries = industriesData.filter((i) => i.slug !== industry.slug).slice(0, 3);
---

<PageLayout
  title={`${industry.name} PCB Manufacturing & Assembly — PCB Indonesia`}
  description={industry.description}
  breadcrumbs={breadcrumbs.map(b => ({ name: b.label, item: b.href || '' }))}
>
  <!-- Hero Section -->
  <section class="bg-white border-b border-border py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumb items={breadcrumbs} />

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center mt-6">
        <div class="lg:col-span-8 space-y-4">
          <span class="text-xs font-bold tracking-widest text-brand-600 uppercase block">
            INDUSTRY SOLUTIONS
          </span>

          <h1 class="text-3xl sm:text-5xl font-black text-dark tracking-tight leading-tight">
            {industry.name}
          </h1>

          <p class="text-lg sm:text-xl font-semibold text-brand-700">
            {industry.tagline}
          </p>

          <p class="text-sm sm:text-base text-secondary leading-relaxed">
            {industry.description}
          </p>

          <div class="flex flex-wrap gap-4 pt-4">
            <a
              href="/quote"
              class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-brand-500 hover:bg-brand-600 text-white font-semibold text-xs sm:text-sm shadow-md shadow-brand-500/20 transition-all duration-200"
            >
              <span>Get a Quote for {industry.name}</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>

            <a
              href="/contact"
              class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-surface hover:bg-white text-dark font-semibold text-xs sm:text-sm border border-border transition-all duration-200"
            >
              <span>Speak with Sector Specialist</span>
            </a>
          </div>
        </div>

        <!-- Industry Metrics Card -->
        <div class="lg:col-span-4 bg-surface rounded-3xl p-6 border border-border shadow-card space-y-4">
          <h3 class="text-sm font-bold text-dark uppercase tracking-wider border-b border-border pb-3">
            Sector Benchmarks
          </h3>

          <div class="space-y-4">
            {industry.stats.map((st) => (
              <div class="flex items-center justify-between">
                <span class="text-xs text-secondary">{st.label}</span>
                <span class="text-sm font-bold text-brand-700">{st.value}</span>
              </div>
            ))}
          </div>

          <div class="pt-4 border-t border-border">
            <span class="text-xs font-bold text-dark block mb-2">Quality & Compliance</span>
            <div class="flex flex-wrap gap-1.5">
              {industry.keyStandards.map((std) => (
                <span class="text-[11px] font-semibold px-2 py-0.5 rounded bg-white border border-border text-dark">
                  {std}
                </span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Challenges & Solutions -->
  <section class="py-16 bg-[#F8FAF9]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Technical Challenges -->
        <div class="bg-white rounded-3xl p-8 border border-border shadow-card space-y-4">
          <div class="w-10 h-10 rounded-2xl bg-red-50 text-red-600 flex items-center justify-center font-bold">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <h2 class="text-xl font-bold text-dark">Sector Technical Challenges</h2>
          <ul class="space-y-3 pt-2">
            {industry.challenges.map((ch) => (
              <li class="flex items-start gap-3 text-xs sm:text-sm text-secondary">
                <span class="w-1.5 h-1.5 rounded-full bg-red-500 mt-2 flex-shrink-0" />
                <span>{ch}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- PCB Indonesia Solutions -->
        <div class="bg-white rounded-3xl p-8 border border-border shadow-card space-y-4">
          <div class="w-10 h-10 rounded-2xl bg-brand-50 text-brand-600 flex items-center justify-center font-bold">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h2 class="text-xl font-bold text-dark">Our Engineering Solutions</h2>
          <ul class="space-y-3 pt-2">
            {industry.solutions.map((sol) => (
              <li class="flex items-start gap-3 text-xs sm:text-sm text-secondary">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-500 mt-2 flex-shrink-0" />
                <span>{sol}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Applications in Action -->
  <section class="py-16 bg-white border-t border-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-10">
        <span class="text-xs font-bold tracking-widest text-brand-600 uppercase block mb-2">
          REAL-WORLD APPLICATIONS
        </span>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-dark tracking-tight">
          What We Build in {industry.name}
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {industry.applications.map((app, idx) => (
          <div class="p-6 rounded-2xl bg-surface border border-border flex items-start gap-3">
            <div class="w-7 h-7 rounded-lg bg-brand-100 text-brand-800 text-xs font-bold flex items-center justify-center flex-shrink-0 mt-0.5">
              {idx + 1}
            </div>
            <p class="text-xs sm:text-sm font-semibold text-dark">{app}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Other Industries -->
  <section class="py-16 bg-[#F8FAF9] border-t border-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-xl sm:text-2xl font-bold text-dark">Explore Other Sectors</h2>
        <a href="/industries" class="text-xs font-bold text-brand-600 hover:text-brand-700">
          View All Industries →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {otherIndustries.map((item) => (
          <a
            href={`/industries/${item.slug}`}
            class="p-6 bg-white rounded-2xl border border-border hover:shadow-card-hover transition-all flex flex-col justify-between group"
          >
            <div>
              <span class="text-xs font-bold text-brand-600">{item.name}</span>
              <h3 class="text-base font-bold text-dark mt-1 group-hover:text-brand-600 transition-colors">
                {item.tagline}
              </h3>
              <p class="text-xs text-secondary mt-2 line-clamp-2">{item.description}</p>
            </div>
            <div class="pt-4 text-xs font-semibold text-brand-600 flex items-center gap-1 mt-4">
              <span>Learn More</span>
              <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <CTA
    heading={`Ready to Power Your ${industry.name} Hardware?`}
    subtitle="Consult with our engineering team or upload your CAD/Gerber files for an immediate quote."
    primaryBtnText="Request a Quote"
    primaryBtnHref="/quote"
  />
</PageLayout>
