---
import PageLayout from '../layouts/PageLayout.astro';
import { siteConfig } from '../data/site';
import Breadcrumb from '../components/Breadcrumb.astro';
import ContactForm from '../components/react/ContactForm';
import CTA from '../components/CTA.astro';

const breadcrumbs = [{ label: 'Contact' }];
---

<PageLayout
  title={`Contact Us — ${siteConfig.name}`}
  description="Get in touch with PCB Indonesia's engineering and sales team for PCB fabrication, assembly, and turnkey hardware inquiries."
  breadcrumbs={breadcrumbs.map(b => ({ name: b.label, item: '/contact' }))}
>
  <!-- Hero Section -->
  <section class="bg-white border-b border-border py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumb items={breadcrumbs} />

      <div class="max-w-3xl mt-4">
        <span class="text-xs font-bold tracking-widest text-brand-600 uppercase block mb-2">
          GET IN TOUCH
        </span>
        <h1 class="text-3xl sm:text-5xl font-black text-dark tracking-tight leading-tight">
          Let's Talk About Your Project
        </h1>
        <p class="mt-4 text-base sm:text-lg text-secondary leading-relaxed">
          Whether you have an upcoming prototype run, volume manufacturing requirement, or need Design for Manufacturability (DFM) guidance, our domestic engineering team is ready to assist.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Form & Details Grid -->
  <section class="py-16 lg:py-24 bg-[#F8FAF9]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        <!-- Left: Contact Form Island -->
        <div class="lg:col-span-7">
          <ContactForm client:load />
        </div>

        <!-- Right: Contact Information & Factory Details -->
        <div class="lg:col-span-5 space-y-6">
          <!-- Office Card -->
          <div class="bg-white rounded-2xl border border-border p-6 sm:p-8 shadow-card space-y-6">
            <h2 class="text-lg font-bold text-dark border-b border-border pb-3">
              Direct Contact Information
            </h2>

            <div class="space-y-4 text-xs sm:text-sm">
              <!-- Address -->
              <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-lg bg-brand-50 text-brand-600 flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
                <div>
                  <h4 class="font-bold text-dark">Manufacturing Plant & Headquarters</h4>
                  <p class="text-secondary mt-0.5 leading-relaxed">
                    {siteConfig.address.street}<br />
                    {siteConfig.address.city}, {siteConfig.address.province} {siteConfig.address.postalCode}<br />
                    Indonesia
                  </p>
                </div>
              </div>

              <!-- Phone -->
              <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-lg bg-brand-50 text-brand-600 flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                <div>
                  <h4 class="font-bold text-dark">Phone & WhatsApp</h4>
                  <p class="text-secondary mt-0.5">
                    Tel: <a href={`tel:${siteConfig.phone}`} class="text-brand-600 font-medium hover:underline">{siteConfig.phone}</a><br />
                    WhatsApp: <a href={`https://wa.me/${siteConfig.whatsapp.replace(/[^0-9]/g, '')}`} target="_blank" rel="noopener noreferrer" class="text-brand-600 font-medium hover:underline">{siteConfig.whatsapp}</a>
                  </p>
                </div>
              </div>

              <!-- Email -->
              <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-lg bg-brand-50 text-brand-600 flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <div>
                  <h4 class="font-bold text-dark">Email Inquiries</h4>
                  <p class="text-secondary mt-0.5">
                    General: <a href={`mailto:${siteConfig.email}`} class="text-brand-600 hover:underline">{siteConfig.email}</a><br />
                    Sales & RFQ: <a href={`mailto:${siteConfig.salesEmail}`} class="text-brand-600 hover:underline">{siteConfig.salesEmail}</a>
                  </p>
                </div>
              </div>

              <!-- Business Hours -->
              <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-lg bg-brand-50 text-brand-600 flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
                <div>
                  <h4 class="font-bold text-dark">Operating Hours</h4>
                  <p class="text-secondary mt-0.5">
                    {siteConfig.businessHours}
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Fast Quote Banner -->
          <div class="bg-brand-50 border border-brand-200 rounded-2xl p-6 text-center space-y-3">
            <h3 class="text-base font-bold text-dark">Already Have Gerber Files?</h3>
            <p class="text-xs text-secondary leading-relaxed">
              Skip general inquiries and jump straight into our custom PCB quote tool with instant file upload.
            </p>
            <a
              href="/quote"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-brand-500 hover:bg-brand-600 text-white font-semibold text-xs shadow-sm transition-all"
            >
              <span>Instant Quote Request</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</PageLayout>
