---
export interface Props {
  name: 'engineering' | 'quality' | 'domestic' | 'scalable';
  class?: string;
}

const { name, class: className = 'w-16 h-16' } = Astro.props;
---

<div data-3d-icon class:list={["relative flex items-center justify-center transition-transform duration-500 will-change-transform group-hover:scale-110 group-hover:-translate-y-1.5", className]}>
  {name === 'engineering' && (
    <!-- 3D Isometric Exploded Multilayer PCB Stackup with Gold Vias -->
    <svg viewBox="0 0 80 80" fill="none" class="w-full h-full drop-shadow-md">
      <!-- Bottom Layer (L4 Bottom Ground Plane) -->
      <polygon points="40,68 14,53 40,38 66,53" fill="#043828" />
      <polygon points="14,53 14,48 40,63 40,68" fill="#02241A" />
      <polygon points="66,53 66,48 40,63 40,68" fill="#07523C" />

      <!-- Inner Copper Core (L3 Power Plane with Copper Facets) -->
      <polygon points="40,57 14,42 40,27 66,42" fill="#B45309" />
      <polygon points="14,42 14,38 40,53 40,57" fill="#78350F" />
      <polygon points="66,42 66,38 40,53 40,57" fill="#D97706" />

      <!-- Inner Signal Plane (L2 High-Speed Routing) -->
      <polygon points="40,46 14,31 40,16 66,31" fill="#087F5B" />
      <polygon points="14,31 14,27 40,42 40,46" fill="#055B41" />
      <polygon points="66,31 66,27 40,42 40,46" fill="#0E9F73" />

      <!-- Top FR4 Solder Mask (L1 Component Layer) -->
      <polygon points="40,35 14,20 40,5 66,20" fill="#0FA87A" />
      <polygon points="14,20 14,16 40,31 40,35" fill="#07694B" />
      <polygon points="66,20 66,16 40,31 40,35" fill="#14B886" />

      <!-- Gold Plated Through-Hole Vias connecting layers -->
      <circle cx="28" cy="17" r="2" fill="#F59E0B" stroke="#D97706" stroke-width="0.5" />
      <circle cx="40" cy="12" r="2.5" fill="#FDE68A" stroke="#D97706" stroke-width="0.5" />
      <circle cx="52" cy="17" r="2" fill="#F59E0B" stroke="#D97706" stroke-width="0.5" />

      <!-- Top Gold Circuit Routing Lines -->
      <line x1="28" y1="17" x2="40" y2="23" stroke="#FDE68A" stroke-width="1.5" stroke-linecap="round" />
      <line x1="40" y1="23" x2="52" y2="17" stroke="#FDE68A" stroke-width="1.5" stroke-linecap="round" />
      <line x1="40" y1="12" x2="40" y2="23" stroke="#FDE68A" stroke-width="1.5" stroke-linecap="round" />

      <!-- Micro SMD Chip placed on top -->
      <polygon points="40,26 34,22 40,18 46,22" fill="#1E293B" />
      <polygon points="34,22 34,20 40,24 40,26" fill="#0F172A" />
      <polygon points="46,22 46,20 40,24 40,26" fill="#334155" />
      <circle cx="37" cy="21" r="0.75" fill="#94A3B8" />
      <circle cx="43" cy="21" r="0.75" fill="#94A3B8" />
    </svg>
  )}

  {name === 'quality' && (
    <!-- 3D Isometric BGA Microchip with Solder Balls and Inspection Grid -->
    <svg viewBox="0 0 80 80" fill="none" class="w-full h-full drop-shadow-md">
      <!-- 3D Interposer Base Substrate -->
      <polygon points="40,68 15,53 40,38 65,53" fill="#087F5B" />
      <polygon points="15,53 15,48 40,63 40,68" fill="#055B41" />
      <polygon points="65,53 65,48 40,63 40,68" fill="#0E9F73" />

      <!-- Array of 3D BGA Solder Balls -->
      <circle cx="28" cy="50" r="2" fill="#CBD5E1" stroke="#64748B" stroke-width="0.5" />
      <circle cx="40" cy="56" r="2" fill="#E2E8F0" stroke="#64748B" stroke-width="0.5" />
      <circle cx="52" cy="50" r="2" fill="#94A3B8" stroke="#64748B" stroke-width="0.5" />
      <circle cx="40" cy="45" r="2" fill="#E2E8F0" stroke="#64748B" stroke-width="0.5" />
      <circle cx="34" cy="47" r="1.75" fill="#CBD5E1" stroke="#64748B" stroke-width="0.5" />
      <circle cx="46" cy="47" r="1.75" fill="#94A3B8" stroke="#64748B" stroke-width="0.5" />

      <!-- 3D Silicon Microchip Die Body -->
      <polygon points="40,44 20,32 40,20 60,32" fill="#1E293B" />
      <polygon points="20,32 20,24 40,36 40,44" fill="#0F172A" />
      <polygon points="60,32 60,24 40,36 40,44" fill="#334155" />

      <!-- Top Metallic Heat Spreader / Silicon Die Cap -->
      <polygon points="40,34 24,25 40,15 56,25" fill="#475569" />
      <polygon points="24,25 24,22 40,31 40,34" fill="#334155" />
      <polygon points="56,25 56,22 40,31 40,34" fill="#64748B" />

      <!-- Laser Engraved IC Branding & Pin 1 Index -->
      <circle cx="29" cy="23" r="1.2" fill="#38BDF8" />
      <line x1="34" y1="23" x2="46" y2="23" stroke="#94A3B8" stroke-width="0.75" />
      <line x1="36" y1="26" x2="44" y2="26" stroke="#94A3B8" stroke-width="0.75" />
    </svg>
  )}

  {name === 'domestic' && (
    <!-- 3D Isometric SMT Component Tape & Reel Feeder with Solder Pads -->
    <svg viewBox="0 0 80 80" fill="none" class="w-full h-full drop-shadow-md">
      <!-- 3D PCB Landing Board with SMT Pads -->
      <polygon points="40,68 14,53 40,38 66,53" fill="#07694B" />
      <polygon points="14,53 14,48 40,63 40,68" fill="#055B41" />
      <polygon points="66,53 66,48 40,63 40,68" fill="#0FA87A" />

      <!-- Golden ENIG SMT Solder Pads on Board -->
      <polygon points="32,51 28,49 32,47 36,49" fill="#F59E0B" />
      <polygon points="48,51 44,49 48,47 52,49" fill="#F59E0B" />
      <polygon points="40,58 36,56 40,54 44,56" fill="#FDE68A" />

      <!-- 3D Component Carrier Tape Strip -->
      <polygon points="40,50 16,36 32,16 56,30" fill="#292524" />
      <polygon points="16,36 16,30 32,10 32,16" fill="#1C1917" />
      <polygon points="56,30 56,24 32,10 32,16" fill="#44403C" />

      <!-- Sprocket Holes along Tape -->
      <circle cx="20" cy="34" r="1.2" fill="#78716C" />
      <circle cx="25" cy="29" r="1.2" fill="#78716C" />
      <circle cx="30" cy="24" r="1.2" fill="#78716C" />
      <circle cx="35" cy="19" r="1.2" fill="#78716C" />

      <!-- SMT Micro Resistors / Capacitors in Pockets -->
      <polygon points="36,36 31,33 35,30 40,33" fill="#0284C7" />
      <polygon points="44,30 39,27 43,24 48,27" fill="#0284C7" />
      <line x1="31" y1="33" x2="33" y2="34" stroke="#CBD5E1" stroke-width="1" />
      <line x1="38" y1="32" x2="40" y2="33" stroke="#CBD5E1" stroke-width="1" />
      <line x1="39" y1="27" x2="41" y2="28" stroke="#CBD5E1" stroke-width="1" />
      <line x1="46" y1="26" x2="48" y2="27" stroke="#CBD5E1" stroke-width="1" />
    </svg>
  )}

  {name === 'scalable' && (
    <!-- 3D Isometric CNC High-Precision PCB Router Spindle & Panel Matrix -->
    <svg viewBox="0 0 80 80" fill="none" class="w-full h-full drop-shadow-md">
      <!-- 3D Production Multi-Panel Array Slab -->
      <polygon points="40,68 14,53 40,38 66,53" fill="#0F766E" />
      <polygon points="14,53 14,48 40,63 40,68" fill="#0D5F58" />
      <polygon points="66,53 66,48 40,63 40,68" fill="#14B8A6" />

      <!-- Breakaway Mouse-Bite Perforations on Panel -->
      <circle cx="28" cy="46" r="0.75" fill="#134E4A" />
      <circle cx="30" cy="47" r="0.75" fill="#134E4A" />
      <circle cx="32" cy="48" r="0.75" fill="#134E4A" />
      <circle cx="48" cy="46" r="0.75" fill="#134E4A" />
      <circle cx="50" cy="47" r="0.75" fill="#134E4A" />
      <circle cx="52" cy="48" r="0.75" fill="#134E4A" />

      <!-- Top Copper Clad Laminate with Routing Paths -->
      <polygon points="40,54 18,41 40,28 62,41" fill="#CA8A04" />
      <polygon points="18,41 18,37 40,50 40,54" fill="#A16207" />
      <polygon points="62,41 62,37 40,50 40,54" fill="#EAB308" />

      <!-- 3D CNC Tool Collet & High-Speed Carbide Drill Bit -->
      <!-- Carbide Bit Stem -->
      <line x1="40" y1="26" x2="40" y2="40" stroke="#94A3B8" stroke-width="3" stroke-linecap="round" />
      <polygon points="40,43 38,39 42,39" fill="#CBD5E1" stroke="#64748B" stroke-width="0.5" />

      <!-- CNC Spindle Collet Chuck Body -->
      <polygon points="40,24 33,20 40,16 47,20" fill="#334155" />
      <polygon points="33,20 33,14 40,18 40,24" fill="#1E293B" />
      <polygon points="47,20 47,14 40,18 40,24" fill="#475569" />

      <!-- Spindle Motor Shaft Housing -->
      <polygon points="40,14 35,11 40,8 45,11" fill="#64748B" />
      <polygon points="35,11 35,6 40,9 40,14" fill="#475569" />
      <polygon points="45,11 45,6 40,9 40,14" fill="#94A3B8" />

      <!-- Routing Depth Circle at Drill Point -->
      <ellipse cx="40" cy="43" rx="3.5" ry="1.75" fill="none" stroke="#FDE047" stroke-width="0.75" stroke-dasharray="1 1" />
    </svg>
  )}
</div>
