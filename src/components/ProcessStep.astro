---
export interface Props {
  step: number;
  title: string;
  description: string;
  isLast?: boolean;
}

const { step, title, description, isLast = false } = Astro.props;
---

<div class="relative flex-1 flex flex-col items-start group">
  <div class="flex items-center w-full mb-3">
    <!-- Clean Minimalist Monospace Step Indicator with Green Accent -->
    <div class="px-2.5 py-1 rounded-sm border border-border bg-white text-dark font-mono font-bold text-xs flex items-center gap-1 group-hover:border-brand-500 transition-colors z-10">
      <span class="text-brand-600 font-bold">0{step}</span>
      <span class="text-secondary/40">//</span>
    </div>

    <!-- Fine hairline connection line with subtle green highlight on hover -->
    {!isLast && (
      <div class="hidden lg:flex flex-1 items-center px-2">
        <div class="h-0.5 w-full bg-border group-hover:bg-brand-500 transition-colors" />
        <span class="text-secondary/50 group-hover:text-brand-600 -ml-1 text-xs transition-colors">→</span>
      </div>
    )}
  </div>

  <!-- Content -->
  <div>
    <h3 class="text-sm sm:text-base font-bold font-display text-dark group-hover:text-brand-600 transition-colors">
      {title}
    </h3>
    <p class="text-xs text-secondary leading-relaxed mt-1 max-w-xs">
      {description}
    </p>
  </div>
</div>
