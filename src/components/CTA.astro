---
export interface Props {
  heading?: string;
  subtitle?: string;
  primaryBtnText?: string;
  primaryBtnHref?: string;
  secondaryBtnText?: string;
  secondaryBtnHref?: string;
  class?: string;
}

const {
  heading = "Let's Build a Smarter, More Connected Indonesia",
  subtitle = "Partner with PCB Indonesia for reliable, high-quality PCB solutions.",
  primaryBtnText = "Get a Quote",
  primaryBtnHref = "/quote",
  secondaryBtnText = "Contact Us",
  secondaryBtnHref = "/contact",
  class: className = "",
} = Astro.props;
---

<section class:list={["w-full py-8 sm:py-12", className]}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="relative overflow-hidden rounded-3xl bg-[#EDF7EE] border border-brand-200/60 p-8 sm:p-12 lg:p-16 flex flex-col md:flex-row items-center justify-between gap-8 shadow-sm">
      <!-- Decorative circuit lines -->
      <div class="absolute -right-12 -bottom-12 w-64 h-64 rounded-full bg-brand-500/5 blur-3xl pointer-events-none" />
      <div class="absolute left-1/3 top-0 w-32 h-32 rounded-full bg-white/40 blur-xl pointer-events-none" />

      <!-- Left Text -->
      <div class="max-w-xl text-center md:text-left z-10">
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-dark tracking-tight leading-snug">
          {heading}
        </h2>
        <p class="mt-3 text-sm sm:text-base text-secondary leading-relaxed">
          {subtitle}
        </p>
      </div>

      <!-- Right Buttons matching ui.png -->
      <div class="flex flex-wrap items-center justify-center md:justify-end gap-3.5 z-10 w-full md:w-auto">
        <a
          href={primaryBtnHref}
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-brand-500 hover:bg-brand-600 text-white font-semibold text-xs sm:text-sm shadow-md shadow-brand-500/20 transition-all duration-200 hover:-translate-y-0.5 whitespace-nowrap"
        >
          <span>{primaryBtnText}</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>

        {secondaryBtnText && (
          <a
            href={secondaryBtnHref}
            class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-white hover:bg-surface text-dark font-semibold text-xs sm:text-sm border border-border hover:border-dark transition-all duration-200 hover:-translate-y-0.5 whitespace-nowrap shadow-sm"
          >
            <span>{secondaryBtnText}</span>
          </a>
        )}
      </div>
    </div>
  </div>
</section>
