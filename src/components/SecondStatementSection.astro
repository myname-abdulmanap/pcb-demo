---
// Second bold editorial statement section following "From Concept to Production": "FROM IDEA TO CIRCUIT."
---

<section
  data-statement-section-2
  class="relative w-full overflow-hidden bg-[#07694B] text-white py-20 sm:py-28 lg:py-36 space-y-6 sm:space-y-8 border-y border-[#055B41] select-none"
>
  <!-- Subtle Industrial Copper Dot Pattern -->
  <div
    class="absolute inset-0 opacity-[0.08] pointer-events-none"
    style="background-image: radial-gradient(#ffffff 1px, transparent 1px); background-size: 36px 36px;"
  />

  <!-- Top Technical Specification Badge -->
  <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between font-mono text-[11px] text-brand-100 tracking-wider relative z-10">
    <span class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-white" />
      <span class="font-bold">EDITORIAL STATEMENT // 02</span>
    </span>
    <span class="hidden sm:inline-block opacity-85">
      ENGINEERED FOR WHAT’S NEXT • HARDWARE REALIZATION
    </span>
  </div>

  <!-- Oversized Primary Heading (Concise, Scroll-Driven) -->
  <div class="overflow-hidden w-full whitespace-nowrap relative z-10 py-6 sm:py-10">
    <div
      data-statement-track-2
      class="inline-flex items-center will-change-transform pl-4 sm:pl-8"
    >
      <h2
        class="text-6xl sm:text-8xl md:text-9xl lg:text-[11.5rem] font-black uppercase font-display tracking-tighter leading-none text-white px-4"
      >
        From Idea To Circuit.
      </h2>
      <span class="text-6xl sm:text-8xl lg:text-[11.5rem] font-black text-white/30 px-6 font-display">
        —
      </span>
      <span class="text-6xl sm:text-8xl lg:text-[11.5rem] font-black uppercase font-display tracking-tighter leading-none text-white/90 px-4">
        Engineered For What’s Next.
      </span>
    </div>
  </div>

  <!-- Secondary Counter-Track -->
  <div class="overflow-hidden w-full whitespace-nowrap pt-4 border-t border-white/15 relative z-10">
    <div
      data-statement-subtrack-2
      class="inline-flex items-center will-change-transform font-mono text-xs sm:text-sm text-brand-100 tracking-widest uppercase font-semibold pl-4 sm:pl-8"
    >
      <span class="px-6">SCHEMATIC TO GERBER</span>
      <span class="opacity-40">•</span>
      <span class="px-6">CONTROLLED IMPEDANCE DFM</span>
      <span class="opacity-40">•</span>
      <span class="px-6">24H RAPID TURNAROUND</span>
      <span class="opacity-40">•</span>
      <span class="px-6">HIGH-SPEED SMT ASSEMBLY</span>
    </div>
  </div>
</section>
