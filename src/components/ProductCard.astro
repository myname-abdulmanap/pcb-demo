---
import type { ProductItem } from '../data/products';

export interface Props {
  product: ProductItem;
  index?: number;
}

const { product, index = 1 } = Astro.props;
---

<article data-product-card class="group bg-white rounded-sm border border-border overflow-hidden hover:border-brand-500 transition-all duration-200 flex flex-col hover:-translate-y-0.5">
  <!-- Image Container -->
  <div class="relative aspect-[16/10] overflow-hidden bg-surface-secondary border-b border-border">
    <img
      src={product.image.src}
      alt={product.image.alt}
      class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-500"
      loading="lazy"
      width="600"
      height="375"
    />
    <!-- Subtle Brutalist Tag Overlay -->
    <div class="absolute top-2.5 left-2.5">
      <span class="font-mono text-[10px] uppercase tracking-wider bg-white/95 backdrop-blur-xs text-dark px-2 py-0.5 border border-border font-medium">
        SPEC // {product.category}
      </span>
    </div>
  </div>

  <!-- Content -->
  <div class="p-5 flex-1 flex flex-col justify-between">
    <div>
      <div class="flex items-center gap-1.5 mb-2 font-mono text-[10px] text-brand-600 tracking-wider">
        <span class="font-bold">0{index} /</span>
        <span class="text-secondary/70">CATALOG ITEM</span>
      </div>

      <h3 class="text-base font-bold font-display text-dark group-hover:text-brand-600 transition-colors">
        <a href={`/products/${product.slug}`} class="focus:outline-none">
          {product.title}
        </a>
      </h3>

      <p class="mt-2 text-xs text-secondary leading-relaxed line-clamp-2">
        {product.description}
      </p>
    </div>

    <!-- Bottom Action Link -->
    <div class="pt-4 flex items-center justify-between border-t border-border mt-5">
      <a
        href={`/products/${product.slug}`}
        class="text-xs font-mono font-semibold text-brand-600 hover:text-brand-700 transition-colors inline-flex items-center gap-1"
        aria-label={`View details for ${product.title}`}
      >
        <span>Specifications</span>
        <span class="group-hover:translate-x-1 transition-transform">→</span>
      </a>

      <span class="text-[10px] font-mono text-secondary bg-surface-secondary px-2 py-0.5 border border-border/80">
        {product.leadTime || 'Quick-Turn'}
      </span>
    </div>
  </div>
</article>
