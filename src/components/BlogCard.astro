---
export interface Props {
  title: string;
  description: string;
  pubDate: Date | string;
  category: string;
  featuredImage: string;
  slug: string;
  imageAlt?: string;
  index?: number;
}

const {
  title,
  description,
  pubDate,
  category,
  featuredImage,
  slug,
  imageAlt = title,
  index = 1,
} = Astro.props;

const formattedDate = new Date(pubDate).toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});
---

<article data-blog-card class="group bg-white rounded-sm border border-border overflow-hidden hover:border-brand-500 transition-all duration-200 flex flex-col hover:-translate-y-0.5">
  <!-- Image -->
  <div class="relative aspect-[16/10] overflow-hidden bg-surface-secondary border-b border-border">
    <img
      src={featuredImage}
      alt={imageAlt}
      class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-500"
      loading="lazy"
      width="600"
      height="375"
    />
    <div class="absolute top-2.5 left-2.5">
      <span class="font-mono text-[10px] uppercase tracking-wider bg-white/95 backdrop-blur-xs text-dark px-2 py-0.5 border border-border font-medium">
        ARTICLE // 0{index}
      </span>
    </div>
  </div>

  <!-- Content -->
  <div class="p-5 flex-1 flex flex-col justify-between">
    <div>
      <!-- Meta Details -->
      <div class="flex items-center gap-2 mb-2 font-mono text-[10px] text-brand-600 tracking-wider">
        <span class="font-bold">{category}</span>
        <span class="text-secondary/40">•</span>
        <time class="text-secondary">
          {formattedDate}
        </time>
      </div>

      <h3 class="text-base font-bold font-display text-dark group-hover:text-brand-600 transition-colors leading-snug line-clamp-2 mb-2">
        <a href={`/blog/${slug}`} class="focus:outline-none">
          {title}
        </a>
      </h3>

      <p class="text-xs text-secondary line-clamp-2 leading-relaxed">
        {description}
      </p>
    </div>

    <!-- Read More CTA -->
    <div class="pt-4 border-t border-border mt-4 flex items-center justify-between">
      <a
        href={`/blog/${slug}`}
        class="inline-flex items-center gap-1.5 text-xs font-mono font-semibold text-brand-600 hover:text-brand-700 transition-colors"
      >
        <span>Read article</span>
        <span class="group-hover:translate-x-1 transition-transform">→</span>
      </a>
      <span class="text-[10px] font-mono text-secondary">
        5 MIN READ
      </span>
    </div>
  </div>
</article>
