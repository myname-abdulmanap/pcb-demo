---
export interface Props {
  title: string;
  description: string;
  pubDate: Date | string;
  category: string;
  featuredImage: string;
  slug: string;
  imageAlt?: string;
}

const {
  title,
  description,
  pubDate,
  category,
  featuredImage,
  slug,
  imageAlt = title,
} = Astro.props;

const formattedDate = new Date(pubDate).toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});
---

<article class="group bg-white rounded-2xl border border-border overflow-hidden shadow-card hover:shadow-card-hover transition-all duration-300 flex flex-col hover:-translate-y-1">
  <!-- Image -->
  <div class="relative aspect-[16/10] overflow-hidden bg-surface">
    <img
      src={featuredImage}
      alt={imageAlt}
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      loading="lazy"
      width="600"
      height="375"
    />
  </div>

  <!-- Content -->
  <div class="p-6 flex-1 flex flex-col justify-between">
    <div>
      <!-- Meta Badge & Date -->
      <div class="flex items-center gap-2 mb-3">
        <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-brand-50 text-brand-700 border border-brand-200">
          {category}
        </span>
        <span class="text-[11px] text-secondary">
          {formattedDate}
        </span>
      </div>

      <h3 class="text-base font-bold text-dark group-hover:text-brand-600 transition-colors leading-snug line-clamp-2 mb-2">
        <a href={`/blog/${slug}`} class="focus:outline-none">
          {title}
        </a>
      </h3>

      <p class="text-xs text-secondary line-clamp-2 leading-relaxed">
        {description}
      </p>
    </div>

    <!-- Read More CTA -->
    <div class="pt-4 border-t border-border/60 mt-4">
      <a
        href={`/blog/${slug}`}
        class="inline-flex items-center gap-1.5 text-xs font-semibold text-dark group-hover:text-brand-600 transition-colors"
      >
        <span>Read More</span>
        <svg class="w-3.5 h-3.5 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</article>
