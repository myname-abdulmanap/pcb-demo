---
import { siteConfig } from '../data/site';

export interface Props {
  class?: string;
  theme?: 'light' | 'dark';
}

const { class: className = '', theme = 'light' } = Astro.props;
const isDark = theme === 'dark';

const icons = [
  // User/Check icon
  `<svg class="w-5 h-5 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>`,
  // Box / Project icon
  `<svg class="w-5 h-5 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>`,
  // Shield / Quality icon
  `<svg class="w-5 h-5 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>`,
  // Gear / Support icon
  `<svg class="w-5 h-5 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>`,
];
---

<div class:list={["space-y-5", className]}>
  {siteConfig.stats.map((stat, idx) => (
    <div class:list={[
      "flex items-center gap-4 p-3 rounded-2xl transition-all",
      isDark ? "hover:bg-white/5" : "hover:bg-brand-50/50"
    ]}>
      <!-- Icon pill with circle border matching ui.png -->
      <div class="w-12 h-12 rounded-2xl bg-brand-50 border border-brand-100 flex items-center justify-center flex-shrink-0 shadow-sm">
        <Fragment set:html={icons[idx % icons.length]} />
      </div>

      <!-- Stat Values -->
      <div>
        <div class:list={[
          "text-2xl sm:text-3xl font-black tracking-tight",
          isDark ? "text-white" : "text-dark"
        ]}>
          {stat.value}
        </div>
        <div class:list={[
          "text-xs font-semibold",
          isDark ? "text-brand-300" : "text-dark/80"
        ]}>
          {stat.label}
        </div>
      </div>
    </div>
  ))}
</div>
