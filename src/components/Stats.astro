---
import { siteConfig } from '../data/site';

export interface Props {
  class?: string;
  theme?: 'light' | 'dark';
}

const { class: className = '', theme = 'light' } = Astro.props;
const isDark = theme === 'dark';
---

<div class:list={["divide-y divide-border border border-border p-5 sm:p-6 bg-white rounded-sm", className]}>
  {siteConfig.stats.map((stat, idx) => (
    <div class="py-4 first:pt-0 last:pb-0">
      <div class="flex items-baseline gap-1">
        <span class:list={[
          "text-3xl sm:text-4xl font-black font-display tracking-tight",
          isDark ? "text-white" : "text-dark"
        ]}>
          {stat.value}
        </span>
      </div>
      <div class:list={[
        "text-[11px] font-mono tracking-wider mt-1 uppercase flex items-center gap-1.5",
        isDark ? "text-neutral-400" : "text-secondary"
      ]}>
        <span class="text-brand-600 font-bold">0{idx + 1} //</span>
        <span>{stat.label}</span>
      </div>
    </div>
  ))}
</div>
