---
// Our Clients & Partners — Continuous Dual-Track Marquee Section
export interface ClientItem {
  name: string;
  domain: string;
  badge: string;
  svgIcon: string;
}

const row1: ClientItem[] = [
  {
    name: "PT LEN Industri",
    domain: "Defense & Railway Systems",
    badge: "STATE ENTERPRISE",
    svgIcon: `<svg viewBox="0 0 40 40" fill="none" stroke="currentColor" class="w-6 h-6 stroke-[1.5]"><path d="M8 8 L32 8 L32 14 L14 14 L14 32 L8 32 Z" fill="currentColor"/><circle cx="26" cy="24" r="6" stroke="currentColor"/></svg>`
  },
  {
    name: "Telkom IoT Labs",
    domain: "Smart Sensors & Telecommunications",
    badge: "DIGITAL INFRASTRUCTURE",
    svgIcon: `<svg viewBox="0 0 40 40" fill="none" stroke="currentColor" class="w-6 h-6 stroke-[1.5]"><circle cx="20" cy="20" r="14"/><circle cx="20" cy="20" r="8"/><circle cx="20" cy="20" r="2" fill="currentColor"/><path d="M20 6 L20 2 M20 38 L20 34 M6 20 L2 20 M38 20 L34 20"/></svg>`
  },
  {
    name: "ITB Microelectronics",
    domain: "Semiconductor & High-Speed Circuits",
    badge: "RESEARCH INSTITUTE",
    svgIcon: `<svg viewBox="0 0 40 40" fill="none" stroke="currentColor" class="w-6 h-6 stroke-[1.5]"><rect x="10" y="10" width="20" height="20" rx="1"/><path d="M14 6 L14 10 M20 6 L20 10 M26 6 L26 10 M14 30 L14 34 M20 30 L20 34 M26 30 L26 34 M6 14 L10 14 M6 20 L10 20 M6 26 L10 26 M30 14 L34 14 M30 20 L34 20 M30 26 L34 26"/></svg>`
  },
  {
    name: "PENS Robotics",
    domain: "Industrial Automation & Robotics",
    badge: "APPLIED ENGINEERING",
    svgIcon: `<svg viewBox="0 0 40 40" fill="none" stroke="currentColor" class="w-6 h-6 stroke-[1.5]"><polygon points="20,4 34,12 34,28 20,36 6,28 6,12"/><circle cx="20" cy="20" r="5"/><line x1="20" y1="4" x2="20" y2="15"/><line x1="6" y1="28" x2="16" y2="23"/><line x1="34" y1="28" x2="24" y2="23"/></svg>`
  }
];

const row2: ClientItem[] = [
  {
    name: "Gesits EV Powertrain",
    domain: "Electric Mobility & BMS Controls",
    badge: "AUTOMOTIVE HARDWARE",
    svgIcon: `<svg viewBox="0 0 40 40" fill="none" stroke="currentColor" class="w-6 h-6 stroke-[1.5]"><path d="M22 4 L10 22 L18 22 L14 36 L30 18 L22 18 Z"/></svg>`
  },
  {
    name: "Polytron Hardware R&D",
    domain: "Audio & Smart Appliances",
    badge: "CONSUMER HARDWARE",
    svgIcon: `<svg viewBox="0 0 40 40" fill="none" stroke="currentColor" class="w-6 h-6 stroke-[1.5]"><rect x="6" y="8" width="28" height="24" rx="2"/><circle cx="15" cy="20" r="5"/><line x1="26" y1="14" x2="28" y2="14"/><line x1="26" y1="20" x2="28" y2="20"/><line x1="26" y1="26" x2="28" y2="26"/></svg>`
  },
  {
    name: "PT INKA Electronics",
    domain: "Rolling Stock & Traction Inverters",
    badge: "HEAVY TRANSPORT",
    svgIcon: `<svg viewBox="0 0 40 40" fill="none" stroke="currentColor" class="w-6 h-6 stroke-[1.5]"><rect x="8" y="6" width="24" height="24" rx="4"/><line x1="8" y1="18" x2="32" y2="18"/><circle cx="14" cy="24" r="2" fill="currentColor"/><circle cx="26" cy="24" r="2" fill="currentColor"/><line x1="12" y1="34" x2="28" y2="34"/></svg>`
  },
  {
    name: "BRIN Elektronika",
    domain: "Advanced Radar & Telecommunications",
    badge: "NATIONAL RESEARCH",
    svgIcon: `<svg viewBox="0 0 40 40" fill="none" stroke="currentColor" class="w-7 h-7 stroke-[1.5]"><path d="M6 34 C 6 20, 20 6, 34 6"/><path d="M12 34 C 12 24, 24 12, 34 12"/><circle cx="10" cy="30" r="3" fill="currentColor"/><circle cx="34" cy="6" r="3" fill="currentColor"/></svg>`
  }
];

// Duplicate for continuous seamless marquee wrap
const row1Repeated = [...row1, ...row1, ...row1];
const row2Repeated = [...row2, ...row2, ...row2];
---

<section
  data-clients-section
  class="w-full py-16 sm:py-24 bg-[#F7F7F5] border-b border-border overflow-hidden"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-10 sm:mb-14">
    <!-- Section Header -->
    <div data-clients-header class="max-w-3xl space-y-3">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 bg-white border border-border rounded-sm">
        <span class="w-1.5 h-1.5 bg-brand-500 rounded-full" />
        <span class="text-[11px] font-mono tracking-wider text-brand-700 font-bold uppercase">
          07 // INDUSTRY & INSTITUTIONAL PARTNERS
        </span>
      </div>

      <h2 class="text-2xl sm:text-4xl font-extrabold text-dark tracking-tight font-display">
        Our <span class="font-script text-brand-600 font-normal text-[1.15em] inline-block -rotate-1">Clients & Partners</span>
      </h2>

      <p class="text-xs sm:text-sm text-secondary leading-relaxed max-w-xl">
        Trusted by engineering teams and research labs building the next generation of Indonesian electronics, industrial automation, and hardware systems.
      </p>
    </div>
  </div>

  <!-- Continuous Dual-Track Marquee -->
  <div class="space-y-4 sm:space-y-6 w-full overflow-hidden select-none">
    <!-- Row 1: Forward Track (Left to Right) -->
    <div class="overflow-hidden w-full flex">
      <div
        data-marquee-track-1
        class="flex gap-4 sm:gap-6 will-change-transform"
        style="width: max-content;"
      >
        {row1Repeated.map((client, idx) => (
          <div
            class="flex items-center gap-4 px-6 py-4 bg-white border border-border rounded-sm min-w-[280px] sm:min-w-[340px] hover:border-dark transition-all duration-200 group shadow-2xs"
          >
            <div
              class="text-dark/70 group-hover:text-brand-600 transition-colors flex-shrink-0"
              set:html={client.svgIcon}
            />
            <div class="min-w-0">
              <div class="flex items-center gap-2">
                <h3 class="text-xs sm:text-sm font-bold font-display text-dark truncate group-hover:text-brand-600 transition-colors">
                  {client.name}
                </h3>
              </div>
              <p class="text-[11px] text-secondary truncate font-sans pt-0.5">
                {client.domain}
              </p>
            </div>
            <span class="ml-auto text-[9px] font-mono font-semibold px-1.5 py-0.5 bg-surface-secondary border border-border text-secondary rounded-xs flex-shrink-0">
              {client.badge.split(' ')[0]}
            </span>
          </div>
        ))}
      </div>
    </div>

    <!-- Row 2: Reverse Track (Right to Left) -->
    <div class="overflow-hidden w-full flex">
      <div
        data-marquee-track-2
        class="flex gap-4 sm:gap-6 will-change-transform"
        style="width: max-content;"
      >
        {row2Repeated.map((client, idx) => (
          <div
            class="flex items-center gap-4 px-6 py-4 bg-white border border-border rounded-sm min-w-[280px] sm:min-w-[340px] hover:border-dark transition-all duration-200 group shadow-2xs"
          >
            <div
              class="text-dark/70 group-hover:text-brand-600 transition-colors flex-shrink-0"
              set:html={client.svgIcon}
            />
            <div class="min-w-0">
              <div class="flex items-center gap-2">
                <h3 class="text-xs sm:text-sm font-bold font-display text-dark truncate group-hover:text-brand-600 transition-colors">
                  {client.name}
                </h3>
              </div>
              <p class="text-[11px] text-secondary truncate font-sans pt-0.5">
                {client.domain}
              </p>
            </div>
            <span class="ml-auto text-[9px] font-mono font-semibold px-1.5 py-0.5 bg-surface-secondary border border-border text-secondary rounded-xs flex-shrink-0">
              {client.badge.split(' ')[0]}
            </span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Bottom Technical Strip -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-10 pt-4 border-t border-border flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-[11px] font-mono text-secondary">
    <span class="flex items-center gap-2">
      <span class="w-1.5 h-1.5 rounded-full bg-brand-500" />
      <span>ENTERPRISE & RESEARCH HARDWARE VERIFICATION</span>
    </span>
    <span>NDA PROTECTED WORKFLOWS • DIRECT IPC CLASS 3 TESTING</span>
  </div>
</section>
