---
// Bold editorial statement section immediately following Hero: "POWERING INDONESIA'S ELECTRONICS."
---

<section
  data-statement-section
  class="relative w-full overflow-hidden bg-[#087F5B] text-white py-20 sm:py-28 lg:py-36 space-y-6 sm:space-y-8 border-y border-[#066347] select-none"
>
  <!-- Subtle Industrial Circuit Grid Pattern -->
  <div
    class="absolute inset-0 opacity-[0.06] pointer-events-none"
    style="background-image: linear-gradient(to right, #ffffff 1px, transparent 1px), linear-gradient(to bottom, #ffffff 1px, transparent 1px); background-size: 44px 44px;"
  />

  <!-- Top Technical Specification Badge -->
  <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between font-mono text-[11px] text-brand-100 tracking-wider relative z-10">
    <span class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-white" />
      <span class="font-bold">EDITORIAL STATEMENT // 01</span>
    </span>
    <span class="hidden sm:inline-block opacity-85">
      IPC CLASS 3 • DIRECT DOMESTIC FABRICATION
    </span>
  </div>

  <!-- Oversized Primary Heading (Concise, Scroll-Driven) -->
  <div class="overflow-hidden w-full whitespace-nowrap relative z-10 py-6 sm:py-10">
    <div
      data-statement-track
      class="inline-flex items-center will-change-transform pl-4 sm:pl-8"
    >
      <h2
        class="text-6xl sm:text-8xl md:text-9xl lg:text-[11.5rem] font-black uppercase font-display tracking-tighter leading-none text-white px-4"
      >
        Powering Indonesia’s Electronics.
      </h2>
    </div>
  </div>

  <!-- Secondary Technical Counter-Track -->
  <div class="overflow-hidden w-full whitespace-nowrap pt-4 border-t border-white/15 relative z-10">
    <div
      data-statement-subtrack
      class="inline-flex items-center will-change-transform font-mono text-xs sm:text-sm text-brand-100 tracking-widest uppercase font-semibold pl-4 sm:pl-8"
    >
      <span class="px-6">MULTI-LAYER PCB FABRICATION</span>
      <span class="opacity-40">•</span>
      <span class="px-6">PRECISION SMT & BGA ASSEMBLY</span>
      <span class="opacity-40">•</span>
      <span class="px-6">IPC CLASS 3 CERTIFIED</span>
      <span class="opacity-40">•</span>
      <span class="px-6">100% DOMESTIC PRODUCTION</span>
    </div>
  </div>
</section>
