---
// Bold editorial statement section immediately following Hero: "POWERING INDONESIA'S ELECTRONICS."
// Editorial Quote-Style Experience inspired by premium Awwwards websites
---

<section
  data-statement-section
  class="relative w-full overflow-hidden bg-[#087F5B] text-white py-24 sm:py-32 lg:py-44 border-y border-[#066347] select-none"
>
  <!-- Subtle Industrial Circuit Grid Pattern -->
  <div
    class="absolute inset-0 opacity-[0.06] pointer-events-none"
    style="background-image: linear-gradient(to right, #ffffff 1px, transparent 1px), linear-gradient(to bottom, #ffffff 1px, transparent 1px); background-size: 40px 40px;"
  />

  <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 sm:space-y-12">
    <!-- Top Technical Specification Badge -->
    <div
      data-statement-meta
      class="flex flex-wrap items-center justify-between gap-3 font-mono text-[11px] text-brand-100/90 tracking-wider pb-6 border-b border-white/15"
    >
      <div class="flex items-center gap-2.5">
        <span class="w-2 h-2 rounded-full bg-white animate-pulse" />
        <span class="font-bold uppercase tracking-widest text-white">01 // EDITORIAL STATEMENT</span>
      </div>
      <div class="flex items-center gap-4 text-[10px] sm:text-[11px] text-brand-100/75">
        <span>IPC-A-610 CLASS 3 HIGH-RELIABILITY</span>
        <span class="hidden sm:inline">•</span>
        <span class="hidden sm:inline">DIRECT DOMESTIC FABRICATION</span>
      </div>
    </div>

    <!-- Main Editorial Quote Composition -->
    <div
      data-statement-quote-container
      class="relative py-4 sm:py-6"
    >
      <!-- Subtle Decorative Background Quote Icon -->
      <span
        data-quote-mark
        class="absolute -top-10 -left-6 sm:-top-16 sm:-left-12 font-serif text-7xl sm:text-9xl text-white/10 pointer-events-none select-none font-bold leading-none"
        aria-hidden="true"
      >
        “
      </span>

      <!-- Primary Oversized Typography Block -->
      <blockquote class="relative z-10 m-0 p-0">
        <h2
          class="font-extrabold uppercase font-display tracking-tight text-white leading-[1.08]"
          style="font-size: clamp(2.35rem, 6.8vw, 6.25rem);"
        >
          <!-- Masked First Word Reveal -->
          <span class="block overflow-hidden pb-1">
            <span
              data-statement-word-1
              data-i18n-en="“Powering"
              data-i18n-id="“Mendorong"
              class="inline-block will-change-transform"
            >
              “Powering
            </span>
          </span>

          <!-- Typing Effect Row -->
          <span class="block overflow-hidden pt-1">
            <span
              data-statement-typing-wrap
              class="inline-flex items-baseline flex-wrap text-white"
            >
              <span
                data-statement-typed-text
                data-i18n-en="Indonesia’s Electronics.”"
                data-i18n-id="Elektronika Indonesia.”"
                class="inline-block tracking-tight text-white"
              >
                Indonesia’s Electronics.”
              </span>
              <!-- Sleek Editorial Typing Cursor -->
              <span
                data-statement-cursor
                class="inline-block w-2.5 sm:w-3.5 lg:w-4 h-[0.75em] bg-white ml-2 align-baseline will-change-transform"
                style="vertical-align: -0.05em;"
              />
            </span>
          </span>
        </h2>
      </blockquote>
    </div>

    <!-- Bottom Technical Metadata & Capability Footnote -->
    <div
      data-statement-footer
      class="pt-6 border-t border-white/15 flex flex-col sm:flex-row sm:items-center justify-between gap-4 font-mono text-xs text-brand-100/80"
    >
      <div class="flex items-center gap-2">
        <span class="text-white font-bold">[ SYSTEM SPECIFICATION ]</span>
        <span class="hidden md:inline text-brand-100/60">—</span>
        <span class="hidden md:inline">1 TO 32 LAYERS • CONTROLLED IMPEDANCE • LASER DIRECT IMAGING</span>
      </div>
      <div class="flex items-center gap-4 text-[11px] tracking-wider uppercase text-white/90 font-semibold">
        <span>BOGOR HEADQUARTERS & MANUFACTURING FACILITY</span>
        <span class="text-white/40">•</span>
        <span>EST. 2024</span>
      </div>
    </div>
  </div>
</section>
