---
import { siteConfig } from '../data/site';
import { footerQuickLinks, footerServices } from '../data/navigation';
import NewsletterForm from './react/NewsletterForm';
---

<footer class="bg-white border-t border-border mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-14 pb-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8 lg:gap-10 pb-12 border-b border-border">
      <!-- Brand & Manufacturing Facility Column (Bogor) -->
      <div class="lg:col-span-4 space-y-4">
        <a href="/" class="inline-block focus:outline-none" aria-label="PCB Indonesia Home">
          <img
            src="/pcb-indonesia-logo.svg"
            alt="PCB Indonesia Logo"
            class="h-10 w-auto object-contain"
            width="180"
            height="42"
          />
        </a>
        <p
          data-i18n-en="Empowering Indonesian hardware innovation with precision multi-layer PCB fabrication, rapid SMT assembly, and IPC Class 3 certified inspection."
          data-i18n-id="Memberdayakan inovasi hardware Indonesia dengan fabrikasi PCB multi-layer presisi tinggi, perakitan SMT cepat, dan inspeksi terstandarisasi IPC Kelas 3."
          class="text-xs text-secondary leading-relaxed max-w-sm"
        >
          Empowering Indonesian hardware innovation with precision multi-layer PCB fabrication, rapid SMT assembly, and IPC Class 3 certified inspection.
        </p>
        <div class="pt-2 text-xs text-secondary space-y-1.5 border-t border-border/60">
          <p>
            <strong
              data-i18n-en="Factory & Headquarters (Bogor):"
              data-i18n-id="Pabrik & Kantor Pusat (Bogor):"
              class="text-dark font-mono text-[11px] uppercase tracking-wider block text-brand-700"
            >
              Factory & Headquarters (Bogor):
            </strong>
            <span>{siteConfig.address.street}</span>
          </p>
          <p>{siteConfig.address.city}, {siteConfig.address.province} {siteConfig.address.postalCode}, Indonesia</p>
          <p class="text-[11px] text-secondary/80 font-mono pt-0.5">
            <span
              data-i18n-en="Hours:"
              data-i18n-id="Jam Operasional:"
              class="text-dark font-semibold"
            >
              Hours:
            </span> {siteConfig.businessHours}
          </p>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="lg:col-span-2 space-y-3">
        <h4
          data-i18n-en="Quick Links"
          data-i18n-id="Tautan Cepat"
          class="text-xs font-bold font-mono text-dark uppercase tracking-wider"
        >
          Quick Links
        </h4>
        <ul class="space-y-2 text-xs text-secondary font-medium">
          {footerQuickLinks.map((link) => (
            <li>
              <a
                href={link.href}
                data-nav-link={link.label}
                class="hover:text-brand-600 transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Our Services -->
      <div class="lg:col-span-2 space-y-3">
        <h4
          data-i18n-en="Our Services"
          data-i18n-id="Layanan Kami"
          class="text-xs font-bold font-mono text-dark uppercase tracking-wider"
        >
          Our Services
        </h4>
        <ul class="space-y-2 text-xs text-secondary font-medium">
          {footerServices.map((service) => (
            <li>
              <a
                href={service.href}
                data-nav-link={service.label}
                class="hover:text-brand-600 transition-colors"
              >
                {service.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Follow Us / Social Media Icons (Rapih, Visible, Branded) -->
      <div class="lg:col-span-4 space-y-4">
        <div>
          <h4
            data-i18n-en="Connect & Social Media"
            data-i18n-id="Koneksi & Media Sosial"
            class="text-xs font-bold font-mono text-dark uppercase tracking-wider"
          >
            Connect & Social Media
          </h4>
          <p
            data-i18n-en="Follow our latest updates, technical case studies, and electronics industry news."
            data-i18n-id="Ikuti informasi terkini, studi kasus teknis, dan pembaruan industri PCB."
            class="text-[11px] text-secondary mt-1"
          >
            Follow our latest updates, technical case studies, and electronics industry news.
          </p>
        </div>

        <!-- Neat Grid of Branded Social Media Buttons -->
        <div class="grid grid-cols-2 sm:grid-cols-2 gap-2.5">
          <!-- LinkedIn -->
          <a
            href={siteConfig.socials.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-3 p-2.5 rounded-sm border border-border bg-[#F7F7F5] hover:bg-white hover:border-[#0A66C2] hover:shadow-xs transition-all"
            aria-label="Follow PCB Indonesia on LinkedIn"
          >
            <div class="w-8 h-8 rounded-xs bg-[#0A66C2]/10 group-hover:bg-[#0A66C2] flex items-center justify-center transition-colors shrink-0">
              <svg class="w-4 h-4 text-[#0A66C2] group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.64a1.64 1.64 0 1 0 0 3.28 1.64 1.64 0 0 0 0-3.28z"/>
              </svg>
            </div>
            <div class="flex flex-col min-w-0">
              <span class="text-xs font-bold text-dark group-hover:text-[#0A66C2] transition-colors truncate">LinkedIn</span>
              <span class="text-[10px] text-secondary font-mono">@pcb-indonesia</span>
            </div>
          </a>

          <!-- Instagram -->
          <a
            href={siteConfig.socials.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-3 p-2.5 rounded-sm border border-border bg-[#F7F7F5] hover:bg-white hover:border-[#E4405F] hover:shadow-xs transition-all"
            aria-label="Follow PCB Indonesia on Instagram"
          >
            <div class="w-8 h-8 rounded-xs bg-[#E4405F]/10 group-hover:bg-[#E4405F] flex items-center justify-center transition-colors shrink-0">
              <svg class="w-4 h-4 text-[#E4405F] group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </div>
            <div class="flex flex-col min-w-0">
              <span class="text-xs font-bold text-dark group-hover:text-[#E4405F] transition-colors truncate">Instagram</span>
              <span class="text-[10px] text-secondary font-mono">@pcbindonesia</span>
            </div>
          </a>

          <!-- YouTube -->
          <a
            href={siteConfig.socials.youtube}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-3 p-2.5 rounded-sm border border-border bg-[#F7F7F5] hover:bg-white hover:border-[#FF0000] hover:shadow-xs transition-all"
            aria-label="Subscribe to PCB Indonesia on YouTube"
          >
            <div class="w-8 h-8 rounded-xs bg-[#FF0000]/10 group-hover:bg-[#FF0000] flex items-center justify-center transition-colors shrink-0">
              <svg class="w-4 h-4 text-[#FF0000] group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
            </div>
            <div class="flex flex-col min-w-0">
              <span class="text-xs font-bold text-dark group-hover:text-[#FF0000] transition-colors truncate">YouTube</span>
              <span class="text-[10px] text-secondary font-mono">@pcbindonesia</span>
            </div>
          </a>

          <!-- WhatsApp Direct Hotline -->
          <a
            href={`https://wa.me/${siteConfig.whatsapp.replace(/[^0-9]/g, '')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-3 p-2.5 rounded-sm border border-border bg-[#F7F7F5] hover:bg-white hover:border-[#25D366] hover:shadow-xs transition-all"
            aria-label="Chat with PCB Indonesia on WhatsApp"
          >
            <div class="w-8 h-8 rounded-xs bg-[#25D366]/10 group-hover:bg-[#25D366] flex items-center justify-center transition-colors shrink-0">
              <svg class="w-4 h-4 text-[#25D366] group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.969.541 1.838.835 2.802.835 3.181 0 5.767-2.586 5.768-5.766 0-3.18-2.587-5.767-5.774-5.767zm7.55 5.767c0 4.159-3.384 7.543-7.55 7.543-1.312 0-2.541-.341-3.619-.937l-4.412 1.157 1.176-4.298c-.672-1.121-1.045-2.42-1.045-3.765 0-4.159 3.385-7.543 7.55-7.543 4.167.001 7.55 3.385 7.55 7.543zm-3.834 2.124c-.147-.245-.54-.392-1.13-.687-.589-.294-3.484-1.719-4.024-1.915-.54-.196-.933-.294-1.326.294-.393.589-1.522 1.915-1.866 2.308-.343.393-.687.442-1.277.147-.589-.295-2.489-.918-4.741-2.926-1.752-1.562-2.935-3.491-3.279-4.08-.344-.589-.037-.908.258-1.202.265-.265.589-.687.884-1.031.294-.344.393-.589.589-.982.196-.393.098-.736-.049-1.031-.147-.294-1.326-3.192-1.817-4.37-.478-1.147-.964-.991-1.326-1.009l-1.13-.02c-.393 0-1.031.147-1.571.736-.54.589-2.062 2.013-2.062 4.91 0 2.897 2.111 5.696 2.405 6.089.295.393 4.156 6.347 10.067 8.899 1.406.607 2.504.969 3.36 1.24.412.13.788.112 1.085.068.33-.049 1.014-.414 1.157-.814.144-.4.144-.742.1-.814-.044-.072-.162-.116-.309-.263z"/>
              </svg>
            </div>
            <div class="flex flex-col min-w-0">
              <span class="text-xs font-bold text-dark group-hover:text-[#25D366] transition-colors truncate">WhatsApp</span>
              <span class="text-[10px] text-secondary font-mono">+62 811-8899-722</span>
            </div>
          </a>
        </div>

        <!-- Newsletter Subscription Box -->
        <div class="pt-2">
          <NewsletterForm client:visible />
        </div>
      </div>
    </div>

    <!-- Bottom Bar: Copyright & Legal Links -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-secondary gap-4">
      <p
        data-i18n-en="© 2026 PCB Indonesia (PT PCB Teknologi Indonesia) — Bogor, West Java. All rights reserved."
        data-i18n-id="© 2026 PCB Indonesia (PT PCB Teknologi Indonesia) — Bogor, Jawa Barat. Hak cipta dilindungi undang-undang."
      >
        © 2026 PCB Indonesia (PT PCB Teknologi Indonesia) — Bogor, West Java. All rights reserved.
      </p>
      <div class="flex items-center space-x-6">
        <a
          href="/about#privacy"
          data-i18n-en="Privacy Policy"
          data-i18n-id="Kebijakan Privasi"
          class="hover:text-dark transition-colors"
        >
          Privacy Policy
        </a>
        <a
          href="/about#terms"
          data-i18n-en="Terms of Service"
          data-i18n-id="Ketentuan Layanan"
          class="hover:text-dark transition-colors"
        >
          Terms of Service
        </a>
        <a
          href="/sitemap-index.xml"
          data-i18n-en="Sitemap"
          data-i18n-id="Peta Situs"
          class="hover:text-dark transition-colors"
        >
          Sitemap
        </a>
      </div>
    </div>
  </div>
</footer>
