---
import PageLayout from './PageLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import CTA from '../components/CTA.astro';

export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  category: string;
  author: string;
  featuredImage: string;
  imageAlt?: string;
  tags?: string[];
  slug: string;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  category,
  author,
  featuredImage,
  imageAlt = title,
  tags = [],
  slug,
} = Astro.props;

const formattedDate = new Date(pubDate).toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});

const breadcrumbs = [
  { label: 'Blog', href: '/blog' },
  { label: title },
];
---

<PageLayout
  title={title}
  description={description}
  image={featuredImage}
  type="article"
  article={{
    publishedTime: pubDate.toISOString(),
    modifiedTime: updatedDate ? updatedDate.toISOString() : undefined,
    author: author,
    tags: tags,
  }}
  breadcrumbs={breadcrumbs.map(b => ({ name: b.label, item: b.href || '' }))}
>
  <article class="w-full pb-16">
    <!-- Header Hero -->
    <header class="bg-white border-b border-border py-8 sm:py-12">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <Breadcrumb items={breadcrumbs} />

        <div class="flex items-center gap-2 mt-4 mb-3">
          <span class="px-3 py-1 bg-brand-50 text-brand-700 font-bold text-xs rounded-full border border-brand-200 uppercase tracking-wider">
            {category}
          </span>
          <span class="text-xs text-secondary">•</span>
          <time datetime={pubDate.toISOString()} class="text-xs text-secondary">
            {formattedDate}
          </time>
        </div>

        <h1 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold text-dark tracking-tight leading-tight mt-2 mb-4">
          {title}
        </h1>

        <p class="text-base sm:text-lg text-secondary leading-relaxed max-w-3xl">
          {description}
        </p>

        <!-- Author Byline -->
        <div class="flex items-center gap-3 mt-6 pt-6 border-t border-border">
          <div class="w-10 h-10 rounded-full bg-brand-500 text-white flex items-center justify-center font-bold text-sm shadow-sm">
            {author.charAt(0)}
          </div>
          <div>
            <div class="text-xs font-bold text-dark">{author}</div>
            <div class="text-[11px] text-secondary">Hardware & Manufacturing Insights</div>
          </div>
        </div>
      </div>
    </header>

    <!-- Featured Image -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mt-8 mb-10">
      <div class="rounded-3xl overflow-hidden shadow-card border border-border aspect-[16/9]">
        <img
          src={featuredImage}
          alt={imageAlt}
          class="w-full h-full object-cover"
          width="1200"
          height="675"
        />
      </div>
    </div>

    <!-- Article Content -->
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="prose prose-slate max-w-none text-dark/90 leading-relaxed font-normal text-sm sm:text-base space-y-6 [&>h2]:text-2xl [&>h2]:font-extrabold [&>h2]:text-dark [&>h2]:mt-10 [&>h2]:mb-4 [&>h3]:text-xl [&>h3]:font-bold [&>h3]:text-dark [&>h3]:mt-6 [&>h3]:mb-3 [&>ul]:list-disc [&>ul]:pl-5 [&>ul]:space-y-2 [&>ol]:list-decimal [&>ol]:pl-5 [&>ol]:space-y-2 [&>pre]:bg-dark [&>pre]:text-brand-300 [&>pre]:p-4 [&>pre]:rounded-xl [&>pre]:overflow-x-auto [&>code]:bg-surface [&>code]:px-1.5 [&>code]:py-0.5 [&>code]:rounded [&>code]:text-brand-700 [&>p]:leading-relaxed">
        <slot />
      </div>

      <!-- Tags & Share -->
      {tags.length > 0 && (
        <div class="mt-12 pt-6 border-t border-border flex flex-wrap items-center justify-between gap-4">
          <div class="flex flex-wrap items-center gap-2">
            <span class="text-xs font-semibold text-secondary">Tags:</span>
            {tags.map((tag) => (
              <span class="text-xs px-2.5 py-1 rounded-lg bg-surface border border-border text-secondary">
                #{tag}
              </span>
            ))}
          </div>

          <a
            href="/blog"
            class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand-600 hover:text-brand-700 transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            <span>Back to All Articles</span>
          </a>
        </div>
      )}
    </div>

    <!-- Article Call to Action -->
    <CTA
      heading="Need Technical Guidance on Your Next PCB Run?"
      subtitle="Talk to our senior PCB fabrication and assembly engineers for rapid DFM reviews and volume quotes."
      primaryBtnText="Get a Quote"
      primaryBtnHref="/quote"
      secondaryBtnText="Contact Engineering"
      secondaryBtnHref="/contact"
      class="mt-12"
    />
  </article>
</PageLayout>
